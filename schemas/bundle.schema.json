{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:velmora:bundle:1",
  "title": "Velmora bundle references",
  "description": "Reference-only input. The backend additionally checks product/colour/size relationships, current availability, contiguous positions and total against the GBP budget.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 1200},
    "origin": {"enum": ["curated", "customer-created", "AI-generated"]},
    "occasion": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "colour_palette": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "budget_gbp": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000, "multipleOf": 0.01},
    "created_at": {"type": "string", "format": "date-time"},
    "modified_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "published"]},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["product_id", "variant_id", "colour_id", "quantity", "position"],
        "properties": {
          "product_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "variant_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "colour_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "selected_size": {"type": ["string", "null"]},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 20},
          "position": {"type": "integer", "minimum": 0},
          "styling_explanation": {"type": ["string", "null"], "minLength": 1, "maxLength": 600}
        }
      }
    }
  }
}
